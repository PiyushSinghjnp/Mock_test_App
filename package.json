{
  "name": "oliveboard-clone",
  "version": "1.0.0",
  "description": "An authentic, 1:1 reverse-engineered replica of **Oliveboard's live online mock test engine** and performance analytics platform. Built with vanilla HTML/CSS/JavaScript on the frontend and an Express + SQLite backend.",
  "main": "server.js",
  "scripts": {
    "dev": "concurrently \"vite\" \"node server.js\"",
    "dev:frontend": "vite",
    "dev:backend": "node server.js",
    "start": "node server.js",
    "mcp": "node mcp-server.js",
    "db:backup": "node scripts/backup-sqlite.js",
    "db:migrate": "node scripts/migrate-postgres.js",
    "db:check": "node scripts/check-neon-connectivity.js",
    "db:inspect": "node scripts/inspect-postgres.js",
    "test:postgres": "node --test tests/postgres.integration.test.js",
    "test:load": "node --test tests/postgres-runtime-load.test.js",
    "build": "vite build && node --check server.js && node --check server-postgres.js && node --check mcp-server.js && node --check lib/parse-quiz-questions.js",
    "preview": "vite preview",
    "test": "node --test tests/*.test.js && node --check server.js && node --check server-postgres.js && node --check mcp-server.js && node --check js/app.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": ">=22.12 <23"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "directories": {
    "lib": "lib",
    "test": "tests"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "vite": "^8.3.5",
    "vite-plugin-static-copy": "^4.1.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PiyushSinghjnp/Mock_test_App.git"
  },
  "bugs": {
    "url": "https://github.com/PiyushSinghjnp/Mock_test_App/issues"
  },
  "homepage": "https://github.com/PiyushSinghjnp/Mock_test_App#readme"
}
