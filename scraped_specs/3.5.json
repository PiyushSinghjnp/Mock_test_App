        "quesStatus[qIndex] = 2;",
        "$('#sprite-butts' + qIndex).css({ 'background-position': '0px -264px', 'color': '#FFF' });",
        "Advance question to qIndex + 1;",
        "questStatusCount();"
      ],
      "next_state": 2
    },
    {
      "trigger": "Click 'Mark for Review & Next' without selecting an option",
      "initial_state": "0 or 1",
      "condition": "saveSelection() == 0",
      "action": [
