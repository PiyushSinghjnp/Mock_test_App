  "in_exam_action_bar": {
    "fullscreen_toggle": {
      "selector": ".screen-toggle",
      "markup": "<button class=\"screen-toggle\" onclick=\"openFullscreen()\">Enter Full Screen</button>",
      "logic": [
        "let elem = document.getElementById('main-body-fscreen');",
        "if (!document.fullscreenElement) {",
        "  elem.requestFullscreen();",
        "  $('.screen-toggle').text('Exit Full Screen');",
        "} else {",
        "  document.exitFullscreen();",
        "  $('.screen-toggle').text('Enter Full Screen');",
        "}"
      ]
    },
